# Cabeceras de Cloudflare Pages: seguridad y caché.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; media-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY

# La dirección de prueba (*.pages.dev) no debe salir en Google
https://:project.pages.dev/*
  X-Robots-Tag: noindex

/fuentes/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=604800
/galeria/*
  Cache-Control: public, max-age=604800
/flyers/*
  Cache-Control: public, max-age=86400
