// Configuración del Worker de Cloudflare que publica la web.
// "name" tiene que coincidir con el nombre del Worker en el panel de Cloudflare.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "private",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Lista de la newsletter. Cloudflare crea la base de datos sola en la primera publicación (en la UE);
  // la tabla la crea el propio Worker en la primera alta (src/newsletter.js).
  "d1_databases": [
    { "binding": "DB", "database_name": "sobremesa-newsletter", "jurisdiction": "eu" }
  ],
  "observability": { "enabled": true }
}
